{
  "name": "@tyreterra/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "npm run build --prefix ../../packages/tire-size",
    "dev": "next dev --port 3000",
    "prebuild": "npm run build --prefix ../../packages/tire-size",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest"
  },
  "dependencies": {
    "@tyreterra/tire-size": "0.0.1",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": ["ts-jest", { "tsconfig": { "module": "commonjs", "moduleResolution": "node", "target": "es2021", "lib": ["dom", "esnext"], "esModuleInterop": true, "strict": true, "skipLibCheck": true } }]
    }
  }
}
