# Example for apps/api/.env — placeholders only, never commit real values.
# See DEPLOYMENT.md for what each variable does.

# Database: either a single connection string (takes priority)...
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# ...or discrete vars (defaults match docker-compose.yml for local dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=tyreterra
DATABASE_SSL=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Encryption (AES-256-GCM for price and contact data).
# Required unless NODE_ENV is development/test. Back it up: losing it makes encrypted data unreadable.
ENCRYPTION_KEY=change-me-to-32-plus-char-secret-in-production

# App
NODE_ENV=development
# 3001 locally (matches apps/web/.env.local.example); the server uses 3101
PORT=3001
HOST=127.0.0.1
# Origin of the web app (CORS) and base URL for password-reset links.
# Local `npm run web:dev` serves on 3000; on the server it is http://localhost:3100 (tunnel) or https://<domain>
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email via Resend. Required unless NODE_ENV is development/test — without them
# emails are only written to the log. Enter the key on the server, never in git.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Tyre Terra <noreply@mail.example.com>
# Receives "new registration awaiting approval"; optional
# ADMIN_NOTIFY_EMAIL=admin@example.com
