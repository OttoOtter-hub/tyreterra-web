{
  "name": "tyreterra",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --prefix apps/api",
    "api:build": "npm run build --prefix apps/api",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "test": "npm run test --prefix packages/tire-size && npm run test --prefix apps/web && npm run test --prefix apps/api",
    "test:cov": "npm run test:cov --prefix apps/api",
    "size:build": "npm run build --prefix packages/tire-size"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.3",
    "cron": "^4.4.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "body-parser": "1.20.9",
    "qs": "6.16.1",
    "lodash": "4.18.1",
    "next": {
      "postcss": "8.5.30"
    },
    "@angular-devkit/core": {
      "picomatch": "4.0.7"
    },
    "@nestjs/cli": {
      "glob": "10.5.0"
    }
  }
}
